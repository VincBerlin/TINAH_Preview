# Railway Storage Bucket (reference the bucket's variables in the web service, e.g. BUCKET=${{tinah-media.BUCKET}}).
# Without them the site serves public/media locally.
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
ENDPOINT=https://t3.storageapi.dev
REGION=auto
# Only if the bucket's Credentials tab asks for path-style URLs.
# BUCKET_PATH_STYLE=true
# Optional override for the supplied Spotify link.
SPOTIFY_URL=https://tr.ee/FuFQHdoNV4
PORT=4173
